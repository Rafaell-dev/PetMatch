{
  "name": "petmatch-backend",
  "version": "1.0.0",
  "description": "Sistema de Adoção de Animais",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
